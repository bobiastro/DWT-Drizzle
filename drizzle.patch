+def _clear_cfa_env() -> None:
+    """离开彩机流程时清掉可能残留的环境变量（GUI 连跑多组时尤其重要）。"""
+    for _k in ("DWT_DETAIL_SNR", "DWT_CFA_CHANNELS", "DWT_CFA_K", "DWT_CFA_RAW"):
