+
+def _band_work_par(r):
+    ctx = dict(_BCTX)
+    ctx['fs'] = _FsProxy(np.memmap(ctx['mm_path'], dtype=np.float32, mode='r',
+                                   shape=(ctx['fs_n'], ctx['native_shape'][0],
+                                          ctx['native_shape'][1])),
