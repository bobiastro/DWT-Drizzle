+        G = _cfa.plane(_src, pattern, 'G')
+        B = _cfa.plane(_src, pattern, 'B')
+    except Exception as _e:
+        log('[CA] 估色差失败（%s: %s），按无明显色差处理' % (type(_e).__name__, _e))
+        return (0.0, 0.0), (0.0, 0.0)
+    return _ca_estimate(G, R, B, log, n_star=n_star)
