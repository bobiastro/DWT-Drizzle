+            sg = max(1, int(np.ceil(max(h, w) / 1200.0)))
+            u8 = u8[::sg, ::sg]
+            Path(a.preview).write_bytes(_to_png(u8))
+            print('[预览] %s  %d×%d（抽样 %d）' % (a.preview, u8.shape[1], u8.shape[0], sg))
+        except Exception as e:
+            print('[预览] 生成失败（不影响 XISF）：%s' % e)
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
