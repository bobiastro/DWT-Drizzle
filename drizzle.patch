+def _ca_from_ref(ref: Path, log, n_frames: int = 5):
+    """用参考目录里的 R/G/B 帧（各取前 n 帧平均）估通道偏移。"""
+    import glob
+    try:
+        from xisf_io import read_xisf
+    except Exception:
+        return None
+    out = {}
+    for ch in ('R', 'G', 'B'):
+        fs = sorted(glob.glob(str(ref / '**' / ('*_c_d_%s.xisf' % ch)), recursive=True))
+        if not fs:
+            return None
+        acc = None
+        for f in fs[:n_frames]:
